{
    "position": "top",
    // "margin-top": 5,
    "height": 30,
    "layer": "top",


    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["power-profiles-daemon", "bluetooth", "network", "battery"],
    // "modules-center": ["clock","niri/workspaces", "custom/notification", "backlight", "pulseaudio",, "bluetooth",,, "memory", "cpu", "temperature"],

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Backlight: {percent}%"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "󰂰 {volume}%",
        "format-muted": "<span color='#E95678'></span>", // red
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "tooltip-format": "Volume: {volume}%",
        "format-icons": {
            "headphones": "",
            "hands-free": "",
            "headset": "",
            "default": [
                "<span color='#FFFFFF'></span>", // white
                "<span color='#A7DFEF'></span>", // acqua
                "<span color='#456990'></span>"  // blue
            ]
        }
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "{icon}",
        "format-ethernet": " ",
        "format-disconneted": "󰯡",
        "format-disabled": "󰣼",
        "on-click": "ghostty -e nmtui",
        "max-length": 50,
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "Connected: {essid}",
        "tooltip-format-wifi": "Connected: {essid}",
        "tooltip-format-ethernet": "Connected: {ipaddr}/{cidr}"
    },

    "memory": {
        "format": "{icon}",
        "format-icons": [
            "<span color='#FFFFFF'></span>", // white
            "<span color='#FFFFFF'></span>", // white
            "<span color='#FFFFFF'></span>", // white
            "<span color='#FFFFFF'></span>", // white
            "<span color='#E8EDA2'></span>", // yellow
            "<span color='#E8EDA2'></span>", // yellow
            "<span color='#f6c177'></span>", // orange
            "<span color='#E95678'></span>"  // red
        ],
        "tooltip-format": "Memory used: {percentage}%"
    },

    "temperature": {
        "format": "{icon}",
        "format-icons": [
            "<span color='#87E58E'></span>", // green
            "<span color='#A7DFEF'></span>", // acqua
            "<span color='#FFFFFF'></span>", // white
            "<span color='#FFFFFF'></span>", // white
            "<span color='#E8EDA2'></span>", // yellow
            "<span color='#E8EDA2'></span>", // yellow
            "<span color='#f6c177'></span>", // orange
            "<span color='#E95678'></span>"  // red
        ],
        "tooltip-format": "Temperature: {temperatureC}°C"
    },

    "cpu": {
     "interval": 1,
     "format": "{icon}",
     "format-icons": [
          "<span color='#FFFFFF'></span>", // white
          "<span color='#FFFFFF'></span>", // white
          "<span color='#FFFFFF'></span>", // white
          "<span color='#FFFFFF'></span>", // white
          "<span color='#E8EDA2'></span>", // yellow
          "<span color='#E8EDA2'></span>", // yellow
          "<span color='#f6c177'></span>", // orange
          "<span color='#E95678'></span>"  // red
     ]
    },

    "battery": {
        "format": "{icon}",
        "format-charging": "<span color='#f8f8f2'>󰂄</span>", // white
        "format-icons": [
          "<span color='#dd532e'>󰂎</span>",  // red
          "<span color='#ff9977'>󰁻</span>", // orange
          "<span color='#ffffa5'>󰁾/span>", // yellow
          "<span color='#f8f8f2'>󰂀</span>", // white
          "<span color='#f8f8f2'>󰁹</span>" // white
        ],
        "tooltip-format": "{capacity}%"
    },

    "clock": {
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#ff0000'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "shift_down",
            "on-click": "shift_up"
        }
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power mode: {profile}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "<span color='#E8EDA2'></span>", // yellow
            "balanced": "<span color='#FFFFFF'></span>", // white
            "power-saver": "<span color='#87E58E'>󰌪</span>" // green
        }
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },


    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Left Click: Launch Overwatch\nRight Click: Do not Distrub",
        "format": "{icon}",
        "format-icon": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚"
        },
        "return-type": "json",
        "exec-if": "which swaync-client >/dev/null 2>&1",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }

}
