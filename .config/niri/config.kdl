// --- Startup Spawn
// spawn-at-startup "swayidle" "-w" "timeout" "300" "'swaylock -f'" "timeout" "600" "'niri msg action power-off-monitors; systemctl suspend'" "before-sleep" "'swaylock -f'"
spawn-at-startup "swayosd-server"
spawn-at-startup "swaybg" "-i" "/home/riccardo/Pictures/Wallpapers/wallhaven-mlo6my_1920x1200.png"
spawn-at-startup "xwayland-satellite"



// --- MISC ---
prefer-no-csd
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}
hotkey-overlay {
    skip-at-startup
}
xwayland-satellite {
    path "xwayland-satellite"
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "./modules/input.kdl"
include "./modules/rules.kdl"
include "./modules/layout.kdl"
include "./modules/bindings.kdl"
include "./modules/animations.kdl"

cursor {
    xcursor-theme "Vimix-cursors" // Replace with your installed cursor theme name
    xcursor-size 24               // Set your desired size (e.g., 24 or 32)
}
