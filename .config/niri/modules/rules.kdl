
window-rule {
  geometry-corner-radius 8
  clip-to-geometry true
}

window-rule {
   match app-id="Alacritty"
   match app-id="ghostty"
   match app-id="foot"
   open-maximized true
}

window-rule {
    match app-id=r"firefox$"
    match app-id="google-chrome"
}

window-rule {
   match app-id=r#"firefox$"# title="^Picture-in-Picture$"
   open-floating true
}

window-rule {
    match app-id="gcolor3"
    open-floating true
}

window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
}

window-rule {
   match app-id="org.gnome.NautilusPreviewer"
    open-floating true
}

// gaming config
window-rule {
    match app-id=r#"^([Ss]team)$"#
    open-maximized true
}

window-rule {
    match app-id=r#"^([Ss]team)$"# title="^Friends List$"
    match app-id=r#"^([Ss]team)$"# title="^Steam - News$"
    match app-id=r#"^([Ss]team)$"# title=".* - Chat$"
    match app-id=r#"^([Ss]team)$"# title="^Settings$"
    match app-id=r#"^([Ss]team)$"# title=".* - Property$"
    match app-id=r#"^([Ss]team)$"# title="^Steam Guard.*$"
    open-floating true
}
