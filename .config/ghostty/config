#-----------[ Themes and interface ]-----------
# Color theme:
theme = almost-quiet

# Font config:
font-family = "Maple Mono"
font-size = "11"
window-title-font-family = "Maple Mono"

# Window config:
# Use the colors from my configuration for the window theme:
window-theme = ghostty
gtk-titlebar = false
window-padding-x = 20
window-padding-y = 20

# Splits:
unfocused-split-opacity = 0.4
split-divider-color = A7DFEF

# Cursor:
cursor-color = F8F8F2
cursor-style-blink = true
cursor-text = 000000
shell-integration-features = no-cursor
#custom-shader = shaders/cursor_smear.glsl

#-----------[ System options ]-----------
window-save-state = always
copy-on-select = true
shell-integration-features = true

# Keybindings
keybind = ctrl+space>shift+n=new_window
keybind = ctrl+space>w=close_window

keybind = ctrl+space>c=new_tab
keybind = ctrl+space>shift+t=close_tab:this
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab

keybind = ctrl+space>v=new_split:right
keybind = ctrl+space>s=new_split:down
keybind = ctrl+space>x=close_surface
keybind = ctrl+space>enter=toggle_split_zoom

keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:bottom
keybind = ctrl+space>k=goto_split:top
keybind = ctrl+space>l=goto_split:right

keybind = global:super+shift+t=toggle_quick_terminal
