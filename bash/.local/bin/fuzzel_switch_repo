#!/bin/sh
set -eu

TERMINAL="alacritty"
FUZZEL_FLAGS="-l 20 -w 60 -f 'JetBrainsMono Nerd Font:size=12' -p 'Projects: '"
PROJECT_DIRS=(
    $HOME/Projects/Personal
    $HOME/Projects/Work
)

FILES=()
for dir in ${PROJECT_DIRS[@]}; do
    basedir=$(basename $dir)
    files=$(ls -1d $dir/* | xargs -n1 basename)
    for f in $files; do
        FILES+=("${basedir}/${f}")
    done
done
[ -n "$FILES" ] || exit 0

CHOSEN="$(printf '%s\n' ${FILES[@]} | eval fuzzel --dmenu $FUZZEL_FLAGS)"
[ -n "$CHOSEN" ] || exit 0

DIR="$HOME/Projects/$CHOSEN"

pkill -x $TERMINAL 2>/dev/null || true
sleep 0.1

exec $TERMINAL -e tmux new-session -As "$CHOSEN" -c "$DIR"
